<Project Sdk="Microsoft.NET.Sdk">
  <!-- Desktop shell: a WPF window hosting Microsoft Edge WebView2. The UI is HTML/CSS/vanilla JS
       in wwwroot/; all imaging and file work runs in Loupe.Core. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <PlatformTarget>x64</PlatformTarget>
    <RootNamespace>Loupe.App</RootNamespace>
    <AssemblyName>Loupe</AssemblyName>
    <ApplicationIcon>..\..\assets\loupe.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4258.31" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Loupe.Core\Loupe.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Front end served to WebView2 from https://app.loupe/ -->
    <Content Include="wwwroot\**\*" CopyToOutputDirectory="PreserveNewest" />
    <!-- libjpeg-turbo 3.x runtime (TurboJPEG API), x64 -->
    <None Include="..\..\native\win-x64\libturbojpeg.dll" Link="libturbojpeg.dll" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\native\third-party\**\*" LinkBase="third-party" CopyToOutputDirectory="PreserveNewest" />
    <Resource Include="..\..\assets\loupe.ico" Link="app.ico" />
  </ItemGroup>
</Project>
