<Project Sdk="Microsoft.NET.Sdk">
  <!-- Platform-neutral engine: JPEG decode/encode, tone, thumbnails, safe file operations.
       No WPF or WebView2 references, so it can be unit tested anywhere. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Loupe.Core</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Loupe.Core.Tests" />
  </ItemGroup>
</Project>
